<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>XerahS.App</RootNamespace>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\..'))\</RepoRoot>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(OS)' == 'Windows_NT' And !$(RuntimeIdentifier.StartsWith('linux')) And !$(RuntimeIdentifier.StartsWith('osx'))">net10.0-windows10.0.26100.0</TargetFramework>
    <OutputType Condition="'$(OS)' == 'Windows_NT'">WinExe</OutputType>
    <OutputType Condition="'$(OS)' == 'Windows_NT' And '$(Configuration)' == 'Debug'">Exe</OutputType>
    <OutputType Condition="'$(OS)' != 'Windows_NT'">Exe</OutputType>
    <AssemblyName>XerahS</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\XerahS.UI\Assets\Logo.ico</ApplicationIcon>
    <DefineConstants Condition="'$(OS)' == 'Windows_NT' And '$(CrossCompile)' != 'true'">$(DefineConstants);WINDOWS</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(DefineConstants);MACOS</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(DefineConstants);LINUX</DefineConstants>
    <PublishSingleFile Condition="'$(Configuration)' == 'Release'">true</PublishSingleFile>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) OR $(RuntimeIdentifier.StartsWith('osx'))">
    <Content Include="$(RepoRoot)native/macos/libscreencapturekit_bridge.dylib">
      <Link>libscreencapturekit_bridge.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="BuildNativeMacOS" BeforeTargets="BeforeBuild" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Message Text="Building native macOS library..." Importance="high" />
    <Exec Command="make -C &quot;$(RepoRoot)native/macos&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>
  <ItemGroup>
    <!-- Audits tool is only needed for Debug builds (development/auditing) -->
    <ProjectReference Include="..\..\tools\XerahS.Audits.Tool\XerahS.Audits.Tool.csproj" Condition="'$(Configuration)' == 'Debug'" />
    <ProjectReference Include="..\XerahS.UI\XerahS.UI.csproj" />
    <ProjectReference Include="..\..\core\XerahS.Core\XerahS.Core.csproj" />
    <ProjectReference Include="..\..\tools\XerahS.WatchFolder.Daemon\XerahS.WatchFolder.Daemon.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\platform\XerahS.Platform.Windows\XerahS.Platform.Windows.csproj" Condition="$(RuntimeIdentifier.StartsWith('win')) Or ('$(OS)' == 'Windows_NT' And '$(RuntimeIdentifier)' == '')" />
    <ProjectReference Include="..\..\..\platform\XerahS.Platform.MacOS\XerahS.Platform.MacOS.csproj" Condition="$(RuntimeIdentifier.StartsWith('osx')) Or ('$(OS)' != 'Windows_NT' And '$(RuntimeIdentifier)' == '')" />
    <ProjectReference Include="..\..\..\platform\XerahS.Platform.Linux\XerahS.Platform.Linux.csproj" Condition="$(RuntimeIdentifier.StartsWith('linux')) Or ('$(OS)' != 'Windows_NT' And '$(RuntimeIdentifier)' == '')" />
  </ItemGroup>
  <Target Name="CreateMacOSAppBundle" AfterTargets="Publish" Condition="('$(OS)' != 'Windows_NT' Or '$(CrossCompile)' == 'true') And ('$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64')">
    <PropertyGroup>
    <RootNamespace>XerahS.App</RootNamespace>
      <_MacAppBundle>$(PublishDir)$(AssemblyName).app</_MacAppBundle>
      <_MacContents>$(_MacAppBundle)/Contents</_MacContents>
      <_MacMacOS>$(_MacContents)/MacOS</_MacMacOS>
      <_MacResources>$(_MacContents)/Resources</_MacResources>
      <_MacPlist>$(_MacContents)/Info.plist</_MacPlist>
    </PropertyGroup>
    <MakeDir Directories="$(_MacMacOS);$(_MacResources)" />
    <ItemGroup>
      <_MacPublishFiles Include="$(PublishDir)**" Exclude="$(PublishDir)*.app/**;$(PublishDir)*.pdb;$(PublishDir)*.xml;$(PublishDir)Plugins/**" />
    </ItemGroup>
    <Copy SourceFiles="@(_MacPublishFiles)" DestinationFolder="$(_MacMacOS)/%(_MacPublishFiles.RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(_MacPublishFiles)' != ''" />
    <ItemGroup>
      <_MacPlistLines Include="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;" />
      <_MacPlistLines Include="&lt;plist version=&quot;1.0&quot;&gt;" />
      <_MacPlistLines Include="&lt;dict&gt;" />
      <_MacPlistLines Include="  &lt;key&gt;CFBundleExecutable&lt;/key&gt;" />
      <_MacPlistLines Include="  &lt;string&gt;$(AssemblyName)&lt;/string&gt;" />
      <_MacPlistLines Include="  &lt;key&gt;CFBundleIdentifier&lt;/key&gt;" />
      <_MacPlistLines Include="  &lt;string&gt;$(AssemblyName)&lt;/string&gt;" />
      <_MacPlistLines Include="  &lt;key&gt;CFBundleName&lt;/key&gt;" />
      <_MacPlistLines Include="  &lt;string&gt;$(AssemblyName)&lt;/string&gt;" />
      <_MacPlistLines Include="  &lt;key&gt;CFBundlePackageType&lt;/key&gt;" />
      <_MacPlistLines Include="  &lt;string&gt;APPL&lt;/string&gt;" />
      <_MacPlistLines Include="  &lt;key&gt;CFBundleShortVersionString&lt;/key&gt;" />
      <_MacPlistLines Include="  &lt;string&gt;$(Version)&lt;/string&gt;" />
      <_MacPlistLines Include="  &lt;key&gt;CFBundleVersion&lt;/key&gt;" />
      <_MacPlistLines Include="  &lt;string&gt;$(Version)&lt;/string&gt;" />
      <_MacPlistLines Include="&lt;/dict&gt;" />
      <_MacPlistLines Include="&lt;/plist&gt;" />
    </ItemGroup>
    <WriteLinesToFile File="$(_MacPlist)" Lines="@(_MacPlistLines)" Overwrite="true" Condition="!Exists('$(_MacPlist)')" />
  </Target>
  <Target Name="ConfigureMacOSBundleIcon" AfterTargets="CreateMacOSAppBundle" Condition="'$(OS)' != 'Windows_NT' And Exists('/usr/libexec/PlistBuddy') And ('$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64')">
    <PropertyGroup>
    <RootNamespace>XerahS.App</RootNamespace>
      <_MacAppBundle>$(PublishDir)$(AssemblyName).app</_MacAppBundle>
      <_MacPlist>$(_MacAppBundle)/Contents/Info.plist</_MacPlist>
      <_MacResources>$(_MacAppBundle)/Contents/Resources</_MacResources>
    </PropertyGroup>
    <Copy SourceFiles="..\XerahS.UI\Assets\Logo.icns" DestinationFiles="$(_MacResources)/Logo.icns" Condition="Exists('$(_MacAppBundle)')" />
    <Exec Command="/bin/sh -c 'if /usr/libexec/PlistBuddy -c &quot;Print :CFBundleIconFile&quot; &quot;$(_MacPlist)&quot; &gt;/dev/null 2&gt;&amp;1; then /usr/libexec/PlistBuddy -c &quot;Set :CFBundleIconFile Logo&quot; &quot;$(_MacPlist)&quot;; else /usr/libexec/PlistBuddy -c &quot;Add :CFBundleIconFile string Logo&quot; &quot;$(_MacPlist)&quot;; fi'" Condition="Exists('$(_MacPlist)')" />
    <Exec Command="/bin/sh -c 'if /usr/libexec/PlistBuddy -c &quot;Print :CFBundleIconName&quot; &quot;$(_MacPlist)&quot; &gt;/dev/null 2&gt;&amp;1; then /usr/libexec/PlistBuddy -c &quot;Set :CFBundleIconName Logo&quot; &quot;$(_MacPlist)&quot;; else /usr/libexec/PlistBuddy -c &quot;Add :CFBundleIconName string Logo&quot; &quot;$(_MacPlist)&quot;; fi'" Condition="Exists('$(_MacPlist)')" />
  </Target>

  <Target Name="PublishWatchFolderDaemon" AfterTargets="Publish">
    <Message Text="Publishing watch folder daemon..." Importance="High" />
    <PropertyGroup>
      <_WatchFolderDaemonPublishDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)watchfolder-daemon-publish/'))</_WatchFolderDaemonPublishDir>
      <_WatchFolderDaemonPublishDir Condition="'$(RuntimeIdentifier)' != ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)watchfolder-daemon-publish/$(RuntimeIdentifier)/'))</_WatchFolderDaemonPublishDir>
    </PropertyGroup>

    <RemoveDir Directories="$(_WatchFolderDaemonPublishDir)" />
    <MakeDir Directories="$(_WatchFolderDaemonPublishDir)" />

    <MSBuild Projects="..\..\tools\XerahS.WatchFolder.Daemon\XerahS.WatchFolder.Daemon.csproj"
             Targets="Restore;Publish"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier);OS=$(OS);CrossCompile=$(CrossCompile);SelfContained=$(SelfContained);PublishSingleFile=true;PublishDir=$(_WatchFolderDaemonPublishDir);EnableWindowsTargeting=$(EnableWindowsTargeting);UseSharedCompilation=false;BuildInParallel=false;nodeReuse=false" />

    <ItemGroup>
      <_WatchFolderDaemonPublishedFiles Include="$(_WatchFolderDaemonPublishDir)**/xerahs-watchfolder-daemon*"
                                        Exclude="$(_WatchFolderDaemonPublishDir)**/*.pdb;$(_WatchFolderDaemonPublishDir)**/*.xml" />
    </ItemGroup>

    <Error Condition="'@(_WatchFolderDaemonPublishedFiles)' == ''"
           Text="Watch folder daemon publish output is empty: $(_WatchFolderDaemonPublishDir)" />

    <Copy SourceFiles="@(_WatchFolderDaemonPublishedFiles)"
          DestinationFiles="@(_WatchFolderDaemonPublishedFiles->'$(PublishDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ValidatePublishedWatchFolderDaemon" AfterTargets="PublishWatchFolderDaemon">
    <PropertyGroup>
      <_WatchFolderDaemonExecutableName>xerahs-watchfolder-daemon</_WatchFolderDaemonExecutableName>
      <_WatchFolderDaemonExecutableName Condition="$(RuntimeIdentifier.StartsWith('win'))">xerahs-watchfolder-daemon.exe</_WatchFolderDaemonExecutableName>
      <_WatchFolderDaemonExecutableName Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT'">xerahs-watchfolder-daemon.exe</_WatchFolderDaemonExecutableName>
      <_WatchFolderDaemonRequireRuntimeConfig>true</_WatchFolderDaemonRequireRuntimeConfig>
      <_WatchFolderDaemonRequireRuntimeConfig Condition="$(RuntimeIdentifier.StartsWith('win'))">false</_WatchFolderDaemonRequireRuntimeConfig>
      <_WatchFolderDaemonRequireRuntimeConfig Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT'">false</_WatchFolderDaemonRequireRuntimeConfig>
    </PropertyGroup>

    <Error Condition="!Exists('$(PublishDir)$(_WatchFolderDaemonExecutableName)')"
           Text="Missing watch folder daemon executable in publish output: $(PublishDir)$(_WatchFolderDaemonExecutableName)" />
    <Error Condition="'$(_WatchFolderDaemonRequireRuntimeConfig)' == 'true' and !Exists('$(PublishDir)xerahs-watchfolder-daemon.runtimeconfig.json')"
           Text="Missing watch folder daemon runtimeconfig in publish output: $(PublishDir)xerahs-watchfolder-daemon.runtimeconfig.json" />
  </Target>

  <Target Name="BuildWatchFolderDaemonForDev" AfterTargets="Build">
    <Message Text="Copying watch folder daemon artifacts to app output..." Importance="High" />

    <PropertyGroup>
      <_WatchFolderDaemonBuildDir>$(MSBuildThisFileDirectory)..\..\tools\XerahS.WatchFolder.Daemon\bin\$(Configuration)\$(TargetFramework)\</_WatchFolderDaemonBuildDir>
      <_WatchFolderDaemonBuildDir Condition="'$(RuntimeIdentifier)' != ''">$(_WatchFolderDaemonBuildDir)$(RuntimeIdentifier)\</_WatchFolderDaemonBuildDir>
    </PropertyGroup>

    <ItemGroup>
      <_WatchFolderDaemonBuildFiles Include="$(_WatchFolderDaemonBuildDir)**\*.*"
                                    Exclude="$(_WatchFolderDaemonBuildDir)**\*.pdb;$(_WatchFolderDaemonBuildDir)**\*.xml" />
    </ItemGroup>

    <Copy SourceFiles="@(_WatchFolderDaemonBuildFiles)"
          DestinationFiles="@(_WatchFolderDaemonBuildFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_WatchFolderDaemonBuildFiles)' != ''" />
  </Target>

  <!-- Auto-discover all plugin csproj files under src/desktop/plugins/*/            -->
  <!-- Each plugin csproj must define <PluginId> (e.g. <PluginId>imgur</PluginId>).  -->
  <!-- To add a new bundled plugin: create its folder, csproj, and plugin.json.      -->
  <!-- No edits to this file or to XerahS.sln are needed.                            -->
  <ItemGroup>
    <_DiscoveredPluginProjects Include="..\..\plugins\*\*.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <EnableAppDrivenPluginBuild Condition="'$(EnableAppDrivenPluginBuild)' == '' And '$(BuildingSolutionFile)' == 'true'">false</EnableAppDrivenPluginBuild>
    <EnableAppDrivenPluginBuild Condition="'$(EnableAppDrivenPluginBuild)' == ''">true</EnableAppDrivenPluginBuild>
  </PropertyGroup>

  <Target Name="BuildPlugins" AfterTargets="Build" Condition="'$(SkipBundlePlugins)' != 'true' And '$(EnableAppDrivenPluginBuild)' == 'true'">
    <Message Text="[Plugins] Auto-building discovered plugins: @(_DiscoveredPluginProjects->'%(Filename)', ', ')" Importance="High" />
    <MSBuild Projects="@(_DiscoveredPluginProjects)" Targets="Restore;Build" Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier);HostTargetFramework=$(TargetFramework)" />
  </Target>

  <Target Name="BundlePlugins" AfterTargets="Publish" Condition="'$(SkipBundlePlugins)' != 'true'">
    <Message Text="[Plugins] Auto-publishing discovered plugins: @(_DiscoveredPluginProjects->'%(Filename)', ', ')" Importance="High" />
    <MSBuild Projects="@(_DiscoveredPluginProjects)" Targets="Restore;Publish" Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=false;PublishSingleFile=false;PluginPublishBaseDir=$(PublishDir)Plugins/" />
  </Target>
</Project>
