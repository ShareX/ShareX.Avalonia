<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>XerahS.App</RootNamespace>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\..'))\</RepoRoot>
    <IsWindowsDesktopBuild>false</IsWindowsDesktopBuild>
    <IsMacOSDesktopBuild>false</IsMacOSDesktopBuild>
    <IsLinuxDesktopBuild>false</IsLinuxDesktopBuild>
    <IsWindowsDesktopBuild Condition="$(RuntimeIdentifier.StartsWith('win')) Or ('$(OS)' == 'Windows_NT' And '$(RuntimeIdentifier)' == '' And '$(CrossCompile)' != 'true')">true</IsWindowsDesktopBuild>
    <IsMacOSDesktopBuild Condition="$(RuntimeIdentifier.StartsWith('osx')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX')))">true</IsMacOSDesktopBuild>
    <IsLinuxDesktopBuild Condition="$(RuntimeIdentifier.StartsWith('linux')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))">true</IsLinuxDesktopBuild>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(IsWindowsDesktopBuild)' == 'true'">net10.0-windows10.0.26100.0</TargetFramework>
    <OutputType Condition="'$(IsWindowsDesktopBuild)' == 'true'">WinExe</OutputType>
    <OutputType Condition="'$(IsWindowsDesktopBuild)' == 'true' And '$(Configuration)' == 'Debug'">Exe</OutputType>
    <OutputType Condition="'$(IsWindowsDesktopBuild)' != 'true'">Exe</OutputType>
    <AssemblyName>XerahS</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\XerahS.UI\Assets\Logo.ico</ApplicationIcon>
    <DefineConstants Condition="'$(IsWindowsDesktopBuild)' == 'true'">$(DefineConstants);WINDOWS</DefineConstants>
    <DefineConstants Condition="'$(IsMacOSDesktopBuild)' == 'true'">$(DefineConstants);MACOS</DefineConstants>
    <DefineConstants Condition="'$(IsLinuxDesktopBuild)' == 'true'">$(DefineConstants);LINUX</DefineConstants>
    <PublishSingleFile Condition="'$(Configuration)' == 'Release'">true</PublishSingleFile>
    <SelfContained Condition="'$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) OR $(RuntimeIdentifier.StartsWith('osx'))">
    <Content Include="$(RepoRoot)native/macos/libscreencapturekit_bridge.dylib">
      <Link>libscreencapturekit_bridge.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="BuildNativeMacOS" BeforeTargets="BeforeBuild"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))"
          Inputs="$(RepoRoot)native/macos/screencapturekit_bridge.m;$(RepoRoot)native/macos/screencapturekit_bridge.h"
          Outputs="$(RepoRoot)native/macos/libscreencapturekit_bridge.dylib">
    <Message Text="Building native macOS library..." Importance="high" />
    <Exec Command="make -C &quot;$(RepoRoot)native/macos&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>
  <ItemGroup>
    <!-- Audits tool is only needed for Debug builds (development/auditing) -->
    <ProjectReference Include="..\..\tools\XerahS.Audits.Tool\XerahS.Audits.Tool.csproj" Condition="'$(Configuration)' == 'Debug'" />
    <ProjectReference Include="..\XerahS.UI\XerahS.UI.csproj"
                      GlobalPropertiesToRemove="SelfContained;PublishSingleFile" />
    <ProjectReference Include="..\..\core\XerahS.Core\XerahS.Core.csproj" />
    <ProjectReference Include="..\..\tools\XerahS.WatchFolder.Daemon\XerahS.WatchFolder.Daemon.csproj"
                      Condition="'$(AssembleProduct)' == 'true'"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifier);CrossCompile=$(CrossCompile)" />
    <ProjectReference Include="..\..\cli\XerahS.OmaXerahs\XerahS.OmaXerahs.csproj"
                      Condition="'$(AssembleProduct)' == 'true'"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifier);CrossCompile=$(CrossCompile)" />
    <ProjectReference Include="..\..\..\platform\XerahS.Platform.Windows\XerahS.Platform.Windows.csproj" Condition="'$(IsWindowsDesktopBuild)' == 'true'" />
    <ProjectReference Include="..\..\..\platform\XerahS.Platform.MacOS\XerahS.Platform.MacOS.csproj" Condition="'$(IsMacOSDesktopBuild)' == 'true'" />
    <ProjectReference Include="..\..\..\platform\XerahS.Platform.Linux\XerahS.Platform.Linux.csproj" Condition="'$(IsLinuxDesktopBuild)' == 'true'" />
  </ItemGroup>
  <Target Name="CreateMacOSAppBundle" AfterTargets="Publish" Condition="('$(OS)' != 'Windows_NT' Or '$(CrossCompile)' == 'true') And ('$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64')">
    <PropertyGroup>
    <RootNamespace>XerahS.App</RootNamespace>
      <_MacAppBundle>$(PublishDir)$(AssemblyName).app</_MacAppBundle>
      <_MacContents>$(_MacAppBundle)/Contents</_MacContents>
      <_MacMacOS>$(_MacContents)/MacOS</_MacMacOS>
      <_MacResources>$(_MacContents)/Resources</_MacResources>
      <_MacPlist>$(_MacContents)/Info.plist</_MacPlist>
    </PropertyGroup>
    <MakeDir Directories="$(_MacMacOS);$(_MacResources)" />
    <ItemGroup>
      <_MacPublishFiles Include="$(PublishDir)**" Exclude="$(PublishDir)*.app/**;$(PublishDir)*.pdb;$(PublishDir)*.xml;$(PublishDir)Plugins/**" />
    </ItemGroup>
    <Copy SourceFiles="@(_MacPublishFiles)" DestinationFolder="$(_MacMacOS)/%(_MacPublishFiles.RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(_MacPublishFiles)' != ''" />
    <!-- XIP0078 P1: render Info.plist from the static template so the bundle carries the full
         identity/usage-description set (stable reverse-DNS bundle ID, NSAppleEventsUsageDescription,
         LSMinimumSystemVersion, ...). Always overwrite so republish never leaves a stale plist.
         String replacement is done with property functions instead of sed so Windows
         cross-compilation (package-mac.ps1, CrossCompile=true) produces the same plist. -->
    <PropertyGroup>
      <_MacMinOS>12.3</_MacMinOS>
      <_MacPlistTemplate>$(RepoRoot)build/macos/Info.plist.template</_MacPlistTemplate>
    </PropertyGroup>
    <Error Condition="!Exists('$(_MacPlistTemplate)')" Text="macOS Info.plist template not found: $(_MacPlistTemplate)" />
    <PropertyGroup>
      <_MacPlistContent>$([System.IO.File]::ReadAllText('$(_MacPlistTemplate)').Replace('__EXECUTABLE__', '$(AssemblyName)').Replace('__VERSION__', '$(Version)').Replace('__MIN_OS__', '$(_MacMinOS)'))</_MacPlistContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(_MacPlist)" Lines="$(_MacPlistContent)" Overwrite="true" />
  </Target>
  <Target Name="ConfigureMacOSBundleIcon" AfterTargets="CreateMacOSAppBundle" Condition="'$(OS)' != 'Windows_NT' And Exists('/usr/libexec/PlistBuddy') And ('$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64')">
    <PropertyGroup>
    <RootNamespace>XerahS.App</RootNamespace>
      <_MacAppBundle>$(PublishDir)$(AssemblyName).app</_MacAppBundle>
      <_MacPlist>$(_MacAppBundle)/Contents/Info.plist</_MacPlist>
      <_MacResources>$(_MacAppBundle)/Contents/Resources</_MacResources>
    </PropertyGroup>
    <Copy SourceFiles="..\XerahS.UI\Assets\Logo.icns" DestinationFiles="$(_MacResources)/Logo.icns" Condition="Exists('$(_MacAppBundle)')" />
    <Exec Command="/bin/sh -c 'if /usr/libexec/PlistBuddy -c &quot;Print :CFBundleIconFile&quot; &quot;$(_MacPlist)&quot; &gt;/dev/null 2&gt;&amp;1; then /usr/libexec/PlistBuddy -c &quot;Set :CFBundleIconFile Logo&quot; &quot;$(_MacPlist)&quot;; else /usr/libexec/PlistBuddy -c &quot;Add :CFBundleIconFile string Logo&quot; &quot;$(_MacPlist)&quot;; fi'" Condition="Exists('$(_MacPlist)')" />
    <Exec Command="/bin/sh -c 'if /usr/libexec/PlistBuddy -c &quot;Print :CFBundleIconName&quot; &quot;$(_MacPlist)&quot; &gt;/dev/null 2&gt;&amp;1; then /usr/libexec/PlistBuddy -c &quot;Set :CFBundleIconName Logo&quot; &quot;$(_MacPlist)&quot;; else /usr/libexec/PlistBuddy -c &quot;Add :CFBundleIconName string Logo&quot; &quot;$(_MacPlist)&quot;; fi'" Condition="Exists('$(_MacPlist)')" />
  </Target>

  <!--
    Publish the watch-folder daemon directly into the app's PublishDir.
    No intermediate directory, no glob, no Copy task — dotnet publish writes
    the daemon files directly beside XerahS.exe in the app bundle/publish output.
    This avoids the glob/Copy fragility that silently failed on macOS when
    dotnet publish created an unexpected RID subdirectory structure.
  -->
  <Target Name="PublishWatchFolderDaemon" AfterTargets="Publish">
    <Message Text="Publishing watch folder daemon to $(PublishDir)..." Importance="High" />

    <MSBuild Projects="..\..\tools\XerahS.WatchFolder.Daemon\XerahS.WatchFolder.Daemon.csproj"
             Targets="Restore;Publish"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifier);OS=$(OS);CrossCompile=$(CrossCompile);SelfContained=$(SelfContained);PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;CopyOutputSymbolsToPublishDirectory=false;PublishDir=$(PublishDir);EnableWindowsTargeting=$(EnableWindowsTargeting);UseSharedCompilation=false;BuildInParallel=false;nodeReuse=false" />

    <!-- .NET 10+ single-file publish embeds runtimeconfig and no longer writes the sidecar. -->
    <PropertyGroup>
      <_WatchFolderDaemonRuntimeConfig>$(MSBuildThisFileDirectory)..\..\tools\XerahS.WatchFolder.Daemon\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\xerahs-watchfolder-daemon.runtimeconfig.json</_WatchFolderDaemonRuntimeConfig>
    </PropertyGroup>
    <Copy SourceFiles="$(_WatchFolderDaemonRuntimeConfig)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_WatchFolderDaemonRuntimeConfig)') And !Exists('$(PublishDir)xerahs-watchfolder-daemon.runtimeconfig.json')" />
  </Target>

  <Target Name="ValidatePublishedWatchFolderDaemon" AfterTargets="PublishWatchFolderDaemon">
    <PropertyGroup>
      <_WatchFolderDaemonExecutableName>xerahs-watchfolder-daemon</_WatchFolderDaemonExecutableName>
      <_WatchFolderDaemonExecutableName Condition="$(RuntimeIdentifier.StartsWith('win'))">xerahs-watchfolder-daemon.exe</_WatchFolderDaemonExecutableName>
      <_WatchFolderDaemonExecutableName Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT'">xerahs-watchfolder-daemon.exe</_WatchFolderDaemonExecutableName>
      <_WatchFolderDaemonRequireRuntimeConfig>true</_WatchFolderDaemonRequireRuntimeConfig>
      <_WatchFolderDaemonRequireRuntimeConfig Condition="$(RuntimeIdentifier.StartsWith('win'))">false</_WatchFolderDaemonRequireRuntimeConfig>
      <_WatchFolderDaemonRequireRuntimeConfig Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT'">false</_WatchFolderDaemonRequireRuntimeConfig>
    </PropertyGroup>

    <Error Condition="!Exists('$(PublishDir)$(_WatchFolderDaemonExecutableName)')"
           Text="Missing watch folder daemon executable in publish output: $(PublishDir)$(_WatchFolderDaemonExecutableName)" />
    <Error Condition="'$(_WatchFolderDaemonRequireRuntimeConfig)' == 'true' and !Exists('$(PublishDir)xerahs-watchfolder-daemon.runtimeconfig.json')"
           Text="Missing watch folder daemon runtimeconfig in publish output: $(PublishDir)xerahs-watchfolder-daemon.runtimeconfig.json" />
  </Target>

  <!--
    Publish omaxerahs directly into the app's PublishDir. Same fix as
    PublishWatchFolderDaemon: no intermediate directory, no glob, no Copy task.
  -->
  <Target Name="PublishOmaXerahs" AfterTargets="Publish">
    <Message Text="Publishing omaxerahs to $(PublishDir)..." Importance="High" />

    <MSBuild Projects="..\..\cli\XerahS.OmaXerahs\XerahS.OmaXerahs.csproj"
             Targets="Restore;Publish"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier);RuntimeIdentifiers=$(RuntimeIdentifier);OS=$(OS);CrossCompile=$(CrossCompile);SelfContained=$(SelfContained);PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;CopyOutputSymbolsToPublishDirectory=false;PublishDir=$(PublishDir);EnableWindowsTargeting=$(EnableWindowsTargeting);UseSharedCompilation=false;BuildInParallel=false;nodeReuse=false" />

    <!-- .NET 10+ single-file publish embeds runtimeconfig and no longer writes the sidecar. -->
    <PropertyGroup>
      <_OmaXerahsRuntimeConfig>$(MSBuildThisFileDirectory)..\..\cli\XerahS.OmaXerahs\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\omaxerahs.runtimeconfig.json</_OmaXerahsRuntimeConfig>
    </PropertyGroup>
    <Copy SourceFiles="$(_OmaXerahsRuntimeConfig)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_OmaXerahsRuntimeConfig)') And !Exists('$(PublishDir)omaxerahs.runtimeconfig.json')" />
  </Target>

  <Target Name="ValidatePublishedOmaXerahs" AfterTargets="PublishOmaXerahs">
    <PropertyGroup>
      <_OmaXerahsExecutableName>omaxerahs</_OmaXerahsExecutableName>
      <_OmaXerahsExecutableName Condition="$(RuntimeIdentifier.StartsWith('win'))">omaxerahs.exe</_OmaXerahsExecutableName>
      <_OmaXerahsExecutableName Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT'">omaxerahs.exe</_OmaXerahsExecutableName>
      <_OmaXerahsRequireRuntimeConfig>true</_OmaXerahsRequireRuntimeConfig>
      <_OmaXerahsRequireRuntimeConfig Condition="$(RuntimeIdentifier.StartsWith('win'))">false</_OmaXerahsRequireRuntimeConfig>
      <_OmaXerahsRequireRuntimeConfig Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT'">false</_OmaXerahsRequireRuntimeConfig>
    </PropertyGroup>

    <Error Condition="!Exists('$(PublishDir)$(_OmaXerahsExecutableName)')"
           Text="Missing omaxerahs executable in publish output: $(PublishDir)$(_OmaXerahsExecutableName)" />
    <Error Condition="'$(_OmaXerahsRequireRuntimeConfig)' == 'true' and !Exists('$(PublishDir)omaxerahs.runtimeconfig.json')"
           Text="Missing omaxerahs runtimeconfig in publish output: $(PublishDir)omaxerahs.runtimeconfig.json" />
  </Target>

  <!-- DirectML/ONNX Windows native assets ride along from ImageEditor even on linux-* RIDs. -->
  <Target Name="RemoveNonLinuxNativePublishArtifacts"
          AfterTargets="ValidatePublishedOmaXerahs"
          Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <ItemGroup>
      <_NonLinuxNativePublishArtifacts Include="$(PublishDir)DirectML.dll;$(PublishDir)DirectML.Debug.dll;$(PublishDir)DirectML.pdb;$(PublishDir)DirectML.Debug.pdb;$(PublishDir)onnxruntime.dll;$(PublishDir)onnxruntime_providers_shared.dll;$(PublishDir)libe_sqlite3.a" />
      <_NonLinuxNativePublishArtifacts Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_NonLinuxNativePublishArtifacts)" TreatErrorsAsWarnings="true" />
  </Target>

  <Target Name="BuildWatchFolderDaemonForDev" AfterTargets="Build" Condition="'$(AssembleProduct)' == 'true'">
    <Message Text="Copying watch folder daemon artifacts to app output..." Importance="High" />

    <PropertyGroup>
      <_WatchFolderDaemonBuildDir>$(MSBuildThisFileDirectory)..\..\tools\XerahS.WatchFolder.Daemon\bin\$(Configuration)\$(TargetFramework)\</_WatchFolderDaemonBuildDir>
      <_WatchFolderDaemonBuildDir Condition="'$(RuntimeIdentifier)' != ''">$(_WatchFolderDaemonBuildDir)$(RuntimeIdentifier)\</_WatchFolderDaemonBuildDir>
    </PropertyGroup>

    <ItemGroup>
      <_WatchFolderDaemonBuildFiles Include="$(_WatchFolderDaemonBuildDir)**\*.*"
                                    Exclude="$(_WatchFolderDaemonBuildDir)**\*.pdb;$(_WatchFolderDaemonBuildDir)**\*.xml" />
    </ItemGroup>

    <Copy SourceFiles="@(_WatchFolderDaemonBuildFiles)"
          DestinationFiles="@(_WatchFolderDaemonBuildFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_WatchFolderDaemonBuildFiles)' != ''" />
  </Target>

  <Target Name="CopyVideoEditorWebUiForDev" AfterTargets="Build" Condition="'$(AssembleProduct)' == 'true'">
    <PropertyGroup>
      <_VideoEditorWebUiDistDir>$(RepoRoot)ShareX.VideoEditor\frontend\dist\</_VideoEditorWebUiDistDir>
    </PropertyGroup>

    <ItemGroup>
      <_VideoEditorWebUiBuildFiles Include="$(_VideoEditorWebUiDistDir)**\*" />
    </ItemGroup>

    <Error Condition="'@(_VideoEditorWebUiBuildFiles)' == ''"
           Text="Missing ShareX.VideoEditor frontend build output: $(_VideoEditorWebUiDistDir)" />

    <Copy SourceFiles="@(_VideoEditorWebUiBuildFiles)"
          DestinationFiles="@(_VideoEditorWebUiBuildFiles->'$(OutDir)frontend\dist\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyVideoEditorWebUiForPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_VideoEditorWebUiDistDir>$(RepoRoot)ShareX.VideoEditor\frontend\dist\</_VideoEditorWebUiDistDir>
    </PropertyGroup>

    <ItemGroup>
      <_VideoEditorWebUiPublishFiles Include="$(_VideoEditorWebUiDistDir)**\*" />
    </ItemGroup>

    <Error Condition="'@(_VideoEditorWebUiPublishFiles)' == ''"
           Text="Missing ShareX.VideoEditor frontend build output: $(_VideoEditorWebUiDistDir)" />

    <Copy SourceFiles="@(_VideoEditorWebUiPublishFiles)"
          DestinationFiles="@(_VideoEditorWebUiPublishFiles->'$(PublishDir)frontend\dist\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RemoveTransitiveVideoEditorWebUiPublishItems" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.RelativePath)' != '' and $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('frontend/dist/'))" />
    </ItemGroup>
  </Target>

  <!-- Auto-discover all plugin csproj files under src/desktop/plugins/*/            -->
  <!-- Each plugin csproj must define <PluginId> (e.g. <PluginId>imgur</PluginId>).  -->
  <!-- To add a new bundled plugin: create its folder, csproj, and plugin.json.      -->
  <!-- No edits to this file or to XerahS.sln are needed.                            -->
  <ItemGroup>
    <_DiscoveredPluginProjects Include="..\..\plugins\*\*.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <EnableAppDrivenPluginBuild Condition="'$(EnableAppDrivenPluginBuild)' == '' And '$(AssembleProduct)' == 'true'">true</EnableAppDrivenPluginBuild>
    <EnableAppDrivenPluginBuild Condition="'$(EnableAppDrivenPluginBuild)' == ''">false</EnableAppDrivenPluginBuild>
  </PropertyGroup>

  <Target Name="BuildPlugins" AfterTargets="Build" Condition="'$(AssembleProduct)' == 'true' And '$(SkipBundlePlugins)' != 'true' And '$(EnableAppDrivenPluginBuild)' == 'true'">
    <Message Text="[Plugins] Auto-building discovered plugins: @(_DiscoveredPluginProjects->'%(Filename)', ', ')" Importance="High" />
    <MSBuild Projects="@(_DiscoveredPluginProjects)" Targets="Restore;Build" Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier);HostTargetFramework=$(TargetFramework)" />
  </Target>

  <Target Name="BundlePlugins" AfterTargets="Publish" Condition="'$(SkipBundlePlugins)' != 'true'">
    <Message Text="[Plugins] Auto-publishing discovered plugins: @(_DiscoveredPluginProjects->'%(Filename)', ', ')" Importance="High" />
    <MSBuild Projects="@(_DiscoveredPluginProjects)" Targets="Restore;Publish" Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=false;PublishSingleFile=false;PluginPublishBaseDir=$(PublishDir)Plugins/" />
  </Target>
</Project>
