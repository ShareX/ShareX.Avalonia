<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShareX.Bitly.Plugin.ViewModels"
             x:Class="ShareX.Bitly.Plugin.Views.BitlyConfigView"
             x:DataType="vm:BitlyConfigViewModel">

    <StackPanel Spacing="15">
        <TextBlock Text="Bitly URL Shortener"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <StackPanel Spacing="5">
            <TextBlock Text="Client ID" FontWeight="Medium"/>
            <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"
                     Watermark="Bitly OAuth2 client ID"
                     Width="400"
                     HorizontalAlignment="Left"/>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Client Secret" FontWeight="Medium"/>
            <TextBox Text="{Binding ClientSecret, UpdateSourceTrigger=PropertyChanged}"
                     PasswordChar="*"
                     Watermark="Bitly OAuth2 client secret"
                     Width="400"
                     HorizontalAlignment="Left"/>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Domain (optional)" FontWeight="Medium"/>
            <TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}"
                     Watermark="e.g. bit.ly or your custom domain"
                     Width="300"
                     HorizontalAlignment="Left"/>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Access Token *" FontWeight="Medium"/>
            <TextBox Text="{Binding AccessToken, UpdateSourceTrigger=PropertyChanged}"
                     PasswordChar="*"
                     Watermark="OAuth2 access token from Bitly"
                     Width="400"
                     HorizontalAlignment="Left"/>
            <TextBlock Text="Get a token at https://bitly.com/a/oauth_apps (create an app, then authorize and paste token here)"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       TextWrapping="Wrap"
                       MaxWidth="500"
                       HorizontalAlignment="Left"/>
        </StackPanel>

        <Border Background="{DynamicResource SystemFillColorAttentionBackground}"
                Padding="10"
                CornerRadius="4"
                IsVisible="{Binding !!StatusMessage}">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorAttention}"/>
        </Border>
    </StackPanel>
</UserControl>
