<Project>
  <PropertyGroup>
    <!-- Disable CPM for the ImageEditor submodule which manages its own package versions -->
    <ManagePackageVersionsCentrally Condition="!$(MSBuildProjectDirectory.Contains('ImageEditor'))">true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="11.3.12" />
    <PackageVersion Include="Avalonia.Android" Version="11.3.9" />
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="11.3.12" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="11.3.9" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <PackageVersion Include="Avalonia.iOS" Version="11.3.9" />
    <PackageVersion Include="Avalonia.Skia" Version="11.3.12" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.1.1" />
    <PackageVersion Include="CommunityToolkit.Maui" Version="14.0.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="FluentAvaloniaUI" Version="2.4.1" />
    <PackageVersion Include="FluentFTP" Version="53.0.2" />
    <PackageVersion Include="Material.Avalonia" Version="3.7.4" />
    <PackageVersion Include="Material.Icons.Avalonia" Version="2.1.10" />
    <PackageVersion Include="MegaApiClient" Version="1.10.5" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.30" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.183" />
    <PackageVersion Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageVersion Include="NETStandard.Library" Version="2.0.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="NUnit" Version="4.2.2" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.3.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageVersion Include="ReactiveUI" Version="22.3.1" />
    <PackageVersion Include="SharpHook" Version="7.1.1" />
    <PackageVersion Include="SkiaSharp" Version="2.88.9" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="2.88.9" />
    <PackageVersion Include="SSH.NET" Version="2025.1.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.1" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.1" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.1" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <PackageVersion Include="Tmds.DBus" Version="0.11.0" />
    <PackageVersion Include="Vortice.Direct3D11" Version="3.8.2" />
    <PackageVersion Include="Vortice.DXGI" Version="3.8.2" />
    <PackageVersion Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.9" />
  </ItemGroup>
  <ItemGroup>
    <!-- Keep plugin/abstraction projects on their current Avalonia minor version -->
    <PackageVersion Update="Avalonia" Version="11.3.9"
                    Condition="'$(MSBuildProjectName)' == 'XerahS.AmazonS3.Plugin' Or
                               '$(MSBuildProjectName)' == 'XerahS.Dropbox.Plugin' Or
                               '$(MSBuildProjectName)' == 'XerahS.GitHubGist.Plugin' Or
                               '$(MSBuildProjectName)' == 'XerahS.Imgur.Plugin' Or
                               '$(MSBuildProjectName)' == 'XerahS.Paste2.Plugin' Or
                               '$(MSBuildProjectName)' == 'XerahS.Platform.Abstractions'" />
    <PackageVersion Update="Avalonia.Themes.Fluent" Version="11.3.9"
                    Condition="'$(MSBuildProjectName)' == 'XerahS.AmazonS3.Plugin' Or
                               '$(MSBuildProjectName)' == 'XerahS.Dropbox.Plugin' Or
                               '$(MSBuildProjectName)' == 'XerahS.GitHubGist.Plugin' Or
                               '$(MSBuildProjectName)' == 'XerahS.Imgur.Plugin' Or
                               '$(MSBuildProjectName)' == 'XerahS.Paste2.Plugin'" />
  </ItemGroup>
</Project>
